        <rdfs:label xml:lang="en">superseded</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/asof-kg/ontology#SupersessionOrderShape -->

    <owl:NamedIndividual rdf:about="https://w3id.org/asof-kg/ontology#SupersessionOrderShape">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
        <rdfs:label xml:lang="en">SHACL shape: superseding statement enters the record later</rdfs:label>
        <sh:sparql>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLConstraint"/>
                <sh:message>A statement cannot supersede a statement that entered the record later than it did.</sh:message>
                <sh:prefixes rdf:resource="https://w3id.org/asof-kg/ontology"/>
                <sh:select>SELECT $this WHERE {
            $this asof:supersedes ?old .
            $this asof:hasRecordTime/time:hasBeginning/time:inXSDDateTimeStamp ?rNew .
            ?old  asof:hasRecordTime/time:hasBeginning/time:inXSDDateTimeStamp ?rOld .
            FILTER (xsd:dateTime(STR(?rNew)) &lt; xsd:dateTime(STR(?rOld))) }</sh:select>
            </rdf:Description>
        </sh:sparql>
        <sh:targetSubjectsOf rdf:resource="https://w3id.org/asof-kg/ontology#supersedes"/>
    </owl:NamedIndividual>
    


