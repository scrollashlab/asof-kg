        <rdf:type rdf:resource="https://w3id.org/asof-kg/ontology#EpistemicStatus"/>
        <rdfs:label xml:lang="en">contested</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/asof-kg/ontology#IndeterminateBoundsShape -->

    <owl:NamedIndividual rdf:about="https://w3id.org/asof-kg/ontology#IndeterminateBoundsShape">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
        <rdfs:label xml:lang="en">SHACL shape: earliest bound not after latest bound</rdfs:label>
        <sh:property>
            <rdf:Description>
                <sh:lessThanOrEquals rdf:resource="https://w3id.org/asof-kg/ontology#latest"/>
                <sh:message>Earliest bound is later than latest bound.</sh:message>
                <sh:path rdf:resource="https://w3id.org/asof-kg/ontology#earliest"/>
            </rdf:Description>
        </sh:property>
        <sh:targetClass rdf:resource="https://w3id.org/asof-kg/ontology#IndeterminateInstant"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/asof-kg/ontology#IntervalOrderShape -->

    <owl:NamedIndividual rdf:about="https://w3id.org/asof-kg/ontology#IntervalOrderShape">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
        <rdfs:label xml:lang="en">SHACL shape: interval end after beginning</rdfs:label>
        <sh:sparql>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLConstraint"/>
                <sh:message>Interval ends before or when it begins.</sh:message>
                <sh:prefixes rdf:resource="https://w3id.org/asof-kg/ontology"/>
                <sh:select>SELECT $this WHERE {
            $this time:hasBeginning/time:inXSDDateTimeStamp ?b ;
                  time:hasEnd/time:inXSDDateTimeStamp ?e .
            FILTER (xsd:dateTime(STR(?e)) &lt;= xsd:dateTime(STR(?b))) }</sh:select>
            </rdf:Description>
        </sh:sparql>
        <sh:targetClass rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/asof-kg/ontology#NoEarlyRecordShape -->

    <owl:NamedIndividual rdf:about="https://w3id.org/asof-kg/ontology#NoEarlyRecordShape">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
        <rdfs:label xml:lang="en">SHACL shape: no record time before source publication</rdfs:label>
        <sh:sparql>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLConstraint"/>
                <sh:message>Statement enters the record before the source record it is derived from was published (record-time leakage).</sh:message>
                <sh:prefixes rdf:resource="https://w3id.org/asof-kg/ontology"/>
                <sh:select>SELECT $this WHERE {
            $this asof:hasRecordTime/time:hasBeginning/time:inXSDDateTimeStamp ?r ;
                  prov:wasDerivedFrom/prov:generatedAtTime ?g .
            FILTER (xsd:dateTime(STR(?r)) &lt; xsd:dateTime(STR(?g))) }</sh:select>
            </rdf:Description>
        </sh:sparql>
        <sh:targetClass rdf:resource="https://w3id.org/asof-kg/ontology#TemporalStatement"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/asof-kg/ontology#NoLeakagePredictionShape -->

    <owl:NamedIndividual rdf:about="https://w3id.org/asof-kg/ontology#NoLeakagePredictionShape">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
        <rdfs:label xml:lang="en">SHACL shape: no prediction input after snapshot cutoff</rdfs:label>
        <sh:sparql>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLConstraint"/>
                <sh:message>Prediction used an input that entered the record after the prediction&apos;s snapshot cutoff (temporal leakage).</sh:message>
                <sh:prefixes rdf:resource="https://w3id.org/asof-kg/ontology"/>
                <sh:select>SELECT $this WHERE {
            $this asof:hasCutoff ?c ;
                  asof:usedInput/asof:hasRecordTime/time:hasBeginning/time:inXSDDateTimeStamp ?r .
            FILTER (xsd:dateTime(STR(?r)) &gt; xsd:dateTime(STR(?c))) }</sh:select>
            </rdf:Description>
        </sh:sparql>
        <sh:targetClass rdf:resource="https://w3id.org/asof-kg/ontology#Prediction"/>
    </owl:NamedIndividual>
    


