<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/asof-kg/ontology#"
     xml:base="https://w3id.org/asof-kg/ontology"
     xmlns:ex="https://w3id.org/asof-kg/example#"
     xmlns:sh="http://www.w3.org/ns/shacl#"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:asof="https://w3id.org/asof-kg/ontology#"
     xmlns:mesh="http://id.nlm.nih.gov/mesh/"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:time="http://www.w3.org/2006/time#"
     xmlns:biolink="https://w3id.org/biolink/vocab/"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/asof-kg/ontology">
        <owl:versionIRI rdf:resource="https://w3id.org/asof-kg/ontology/0.1.4"/>
        <dcterms:description xml:lang="en">Excerpt of the AsOf-KG ontology. Every knowledge-graph statement carries two
independent time dimensions: valid time (when the statement holds in the world) and record time
(when a source first made the statement available and, if applicable, when it was withdrawn or
superseded). Intervals reuse W3C OWL-Time; provenance reuses W3C PROV-O; statements align with
Biolink Model associations. The file contains (1) the OWL 2 DL TBox, (2) SHACL shapes for the
numeric temporal checks that OWL cannot express, and (3) a worked example drawn from public
U.S. Food and Drug Administration and CDC records for COVID-19 monoclonal antibodies.</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:title xml:lang="en">AsOf-KG: a bitemporal, evidence-aware extension for Biolink knowledge graphs</dcterms:title>
        <rdfs:label xml:lang="en">AsOf-KG ontology (excerpt)</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://github.com/biolink/biolink-model"/>
        <rdfs:seeAlso rdf:resource="https://www.nih.gov/challenges/its-about-time-temporal-reasoning-biomedical-knowledge-graphs-challenge"/>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/owl-time/"/>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/prov-o/"/>
        <owl:versionInfo>0.1.4</owl:versionInfo>
        <sh:declare>
            <rdf:Description>
                <sh:namespace rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/2001/XMLSchema#</sh:namespace>
                <sh:prefix>xsd</sh:prefix>
            </rdf:Description>
        </sh:declare>
        <sh:declare>
            <rdf:Description>
                <sh:namespace rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/asof-kg/ontology#</sh:namespace>
                <sh:prefix>asof</sh:prefix>
            </rdf:Description>
        </sh:declare>
        <sh:declare>
            <rdf:Description>
                <sh:namespace rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/ns/prov#</sh:namespace>
                <sh:prefix>prov</sh:prefix>
            </rdf:Description>
        </sh:declare>
        <sh:declare>
            <rdf:Description>
                <sh:namespace rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/2006/time#</sh:namespace>
                <sh:prefix>time</sh:prefix>
            </rdf:Description>
        </sh:declare>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#broadMatch -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#broadMatch"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#closeMatch -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#closeMatch"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#exactMatch -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#exactMatch"/>
    


    <!-- http://www.w3.org/ns/shacl#declare -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/shacl#declare"/>
    


    <!-- http://www.w3.org/ns/shacl#lessThanOrEquals -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/shacl#lessThanOrEquals"/>
    


    <!-- http://www.w3.org/ns/shacl#message -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/shacl#message"/>
    


    <!-- http://www.w3.org/ns/shacl#namespace -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/shacl#namespace"/>
    


    <!-- http://www.w3.org/ns/shacl#path -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/shacl#path"/>
    


    <!-- http://www.w3.org/ns/shacl#prefix -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/shacl#prefix"/>
    


    <!-- http://www.w3.org/ns/shacl#prefixes -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/shacl#prefixes"/>
    


    <!-- http://www.w3.org/ns/shacl#property -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/shacl#property"/>
    


    <!-- http://www.w3.org/ns/shacl#select -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/shacl#select"/>
    


    <!-- http://www.w3.org/ns/shacl#sparql -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/shacl#sparql"/>
    


    <!-- http://www.w3.org/ns/shacl#targetClass -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/shacl#targetClass"/>
    


    <!-- http://www.w3.org/ns/shacl#targetSubjectsOf -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/shacl#targetSubjectsOf"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/BFO_0000199 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000199">
        <rdfs:label xml:lang="en">occupies temporal region (BFO)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#hasBeginning -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#hasBeginning">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:label xml:lang="en">has beginning (OWL-Time)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#hasEnd -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#hasEnd">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:label xml:lang="en">has end (OWL-Time)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#intervalAfter -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#intervalAfter">
        <owl:inverseOf rdf:resource="http://www.w3.org/2006/time#intervalBefore"/>
        <rdfs:label xml:lang="en">interval after (OWL-Time)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#intervalBefore -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#intervalBefore">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2006/time#intervalDisjoint"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
        <rdfs:label xml:lang="en">interval before (OWL-Time)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#intervalDisjoint -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#intervalDisjoint">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:label xml:lang="en">interval disjoint (OWL-Time)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#intervalMeets -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#intervalMeets">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2006/time#intervalDisjoint"/>
        <owl:inverseOf rdf:resource="http://www.w3.org/2006/time#intervalMetBy"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
        <rdfs:label xml:lang="en">interval meets (OWL-Time)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#intervalMetBy -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#intervalMetBy">
        <rdfs:label xml:lang="en">interval met by (OWL-Time)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasAttributedTo -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasAttributedTo">
        <rdfs:label xml:lang="en">was attributed to (PROV-O)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasDerivedFrom -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasDerivedFrom">
        <rdfs:label xml:lang="en">was derived from (PROV-O)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/asof-kg/ontology#assignsStatus -->

    <owl:ObjectProperty rdf:about="https://w3id.org/asof-kg/ontology#assignsStatus">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/asof-kg/ontology#StatusAssignment"/>
        <rdfs:range rdf:resource="https://w3id.org/asof-kg/ontology#EpistemicStatus"/>
        <rdfs:label xml:lang="en">assigns status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/asof-kg/ontology#conditionalOnLineage -->

    <owl:ObjectProperty rdf:about="https://w3id.org/asof-kg/ontology#conditionalOnLineage">
        <rdfs:range rdf:resource="https://w3id.org/asof-kg/ontology#Lineage"/>
        <rdfs:label xml:lang="en">conditional on lineage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/asof-kg/ontology#contradicts -->

    <owl:ObjectProperty rdf:about="https://w3id.org/asof-kg/ontology#contradicts">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/asof-kg/ontology#TemporalStatement"/>
        <rdfs:range rdf:resource="https://w3id.org/asof-kg/ontology#TemporalStatement"/>
        <owl:propertyDisjointWith rdf:resource="https://w3id.org/asof-kg/ontology#supersedes"/>
        <rdfs:label xml:lang="en">contradicts</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/asof-kg/ontology#hasRecordTime -->

    <owl:ObjectProperty rdf:about="https://w3id.org/asof-kg/ontology#hasRecordTime">
        <rdfs:range rdf:resource="https://w3id.org/asof-kg/ontology#RecordTimeInterval"/>
        <rdfs:label xml:lang="en">has record time</rdfs:label>
        <skos:definition xml:lang="en">Relates a statement or status assignment to the interval during which it was in the record.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/asof-kg/ontology#hasValidTime -->

    <owl:ObjectProperty rdf:about="https://w3id.org/asof-kg/ontology#hasValidTime">
        <owl:inverseOf rdf:resource="https://w3id.org/asof-kg/ontology#isValidTimeOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/asof-kg/ontology#TemporalStatement"/>
        <rdfs:range rdf:resource="https://w3id.org/asof-kg/ontology#ValidTimeInterval"/>
        <rdfs:label xml:lang="en">has valid time</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/asof-kg/ontology#inRegion -->

    <owl:ObjectProperty rdf:about="https://w3id.org/asof-kg/ontology#inRegion">
        <rdfs:range rdf:resource="https://w3id.org/asof-kg/ontology#Region"/>
        <rdfs:label xml:lang="en">in region</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/asof-kg/ontology#isValidTimeOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/asof-kg/ontology#isValidTimeOf">
        <rdfs:label xml:lang="en">is valid time of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/asof-kg/ontology#notActiveAgainst -->

    <owl:ObjectProperty rdf:about="https://w3id.org/asof-kg/ontology#notActiveAgainst">
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/ChemicalEntity"/>
        <rdfs:range rdf:resource="https://w3id.org/asof-kg/ontology#Lineage"/>
        <rdfs:label xml:lang="en">not active against</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/asof-kg/ontology#occursDuring -->

    <owl:ObjectProperty rdf:about="https://w3id.org/asof-kg/ontology#occursDuring">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000199"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
        <rdfs:label xml:lang="en">occurs during</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/asof-kg/ontology#statusOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/asof-kg/ontology#statusOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/asof-kg/ontology#StatusAssignment"/>
        <rdfs:range rdf:resource="https://w3id.org/asof-kg/ontology#TemporalStatement"/>
        <rdfs:label xml:lang="en">status of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/asof-kg/ontology#supersedes -->

    <owl:ObjectProperty rdf:about="https://w3id.org/asof-kg/ontology#supersedes">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/asof-kg/ontology#supersedesTransitively"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/asof-kg/ontology#TemporalStatement"/>
        <rdfs:range rdf:resource="https://w3id.org/asof-kg/ontology#TemporalStatement"/>
        <rdfs:label xml:lang="en">supersedes</rdfs:label>
        <skos:definition xml:lang="en">Holds when a later statement from the same or a more authoritative source replaces an earlier one on the same subject and predicate.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/asof-kg/ontology#supersedesTransitively -->

    <owl:ObjectProperty rdf:about="https://w3id.org/asof-kg/ontology#supersedesTransitively">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label xml:lang="en">supersedes (transitively)</rdfs:label>
        <skos:definition xml:lang="en">Inferred transitive closure of supersedes: a later statement replaces every statement in the chain it replaced.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/asof-kg/ontology#usedInput -->

    <owl:ObjectProperty rdf:about="https://w3id.org/asof-kg/ontology#usedInput">
        <rdfs:domain rdf:resource="https://w3id.org/asof-kg/ontology#Prediction"/>
        <rdfs:range rdf:resource="https://w3id.org/asof-kg/ontology#TemporalStatement"/>
        <rdfs:label xml:lang="en">used input</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/asof-kg/ontology#validBefore -->

    <owl:ObjectProperty rdf:about="https://w3id.org/asof-kg/ontology#validBefore">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/asof-kg/ontology#validDisjointFrom"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/asof-kg/ontology#hasValidTime"/>
            <rdf:Description rdf:about="http://www.w3.org/2006/time#intervalBefore"/>
            <rdf:Description rdf:about="https://w3id.org/asof-kg/ontology#isValidTimeOf"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="en">valid before</rdfs:label>
        <skos:definition xml:lang="en">Inferred: the first statement stops holding before the second starts to hold.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/asof-kg/ontology#validDisjointFrom -->

    <owl:ObjectProperty rdf:about="https://w3id.org/asof-kg/ontology#validDisjointFrom">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/asof-kg/ontology#hasValidTime"/>
            <rdf:Description rdf:about="http://www.w3.org/2006/time#intervalDisjoint"/>
            <rdf:Description rdf:about="https://w3id.org/asof-kg/ontology#isValidTimeOf"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="en">valid disjoint from</rdfs:label>
        <skos:definition xml:lang="en">Inferred: the two statements never hold at the same time.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/asof-kg/ontology#validMeets -->

    <owl:ObjectProperty rdf:about="https://w3id.org/asof-kg/ontology#validMeets">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/asof-kg/ontology#validDisjointFrom"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/asof-kg/ontology#hasValidTime"/>
            <rdf:Description rdf:about="http://www.w3.org/2006/time#intervalMeets"/>
            <rdf:Description rdf:about="https://w3id.org/asof-kg/ontology#isValidTimeOf"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="en">valid meets</rdfs:label>
        <skos:definition xml:lang="en">Inferred: the second statement starts to hold at the instant the first stops holding (OWL-Time interval meets).</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/biolink/vocab/knowledge_level -->

    <owl:ObjectProperty rdf:about="https://w3id.org/biolink/vocab/knowledge_level">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">knowledge level (Biolink)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/biolink/vocab/object -->

    <owl:ObjectProperty rdf:about="https://w3id.org/biolink/vocab/object">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/Association"/>
        <rdfs:label xml:lang="en">object (Biolink)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/biolink/vocab/predicate -->

    <owl:ObjectProperty rdf:about="https://w3id.org/biolink/vocab/predicate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/Association"/>
        <rdfs:label xml:lang="en">predicate (Biolink)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/biolink/vocab/subject -->

    <owl:ObjectProperty rdf:about="https://w3id.org/biolink/vocab/subject">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/Association"/>
        <rdfs:label xml:lang="en">subject (Biolink)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/biolink/vocab/treats -->

    <owl:ObjectProperty rdf:about="https://w3id.org/biolink/vocab/treats"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2006/time#inXSDDateTimeStamp -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/2006/time#inXSDDateTimeStamp">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <rdfs:label xml:lang="en">in XSD date-time stamp (OWL-Time)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/prov#generatedAtTime -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/prov#generatedAtTime">
        <rdfs:label xml:lang="en">generated at time (PROV-O)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/asof-kg/ontology#earliest -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/asof-kg/ontology#earliest">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/asof-kg/ontology#IndeterminateInstant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <rdfs:label xml:lang="en">earliest</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/asof-kg/ontology#estimatedShare -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/asof-kg/ontology#estimatedShare">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="en">estimated share</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000607"/>
        <skos:definition xml:lang="en">Estimated proportion of cases attributed to the subject lineage during the valid-time interval.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/asof-kg/ontology#hasCutoff -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/asof-kg/ontology#hasCutoff">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/asof-kg/ontology#Prediction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <rdfs:label xml:lang="en">has snapshot cutoff</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/asof-kg/ontology#latest -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/asof-kg/ontology#latest">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/asof-kg/ontology#IndeterminateInstant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <rdfs:label xml:lang="en">latest</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/BFO_0000003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000003">
        <rdfs:label xml:lang="en">occurrent (BFO)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000008 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:label xml:lang="en">temporal region (BFO)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:label xml:lang="en">process (BFO)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000202 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000202">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000008"/>
        <rdfs:label xml:lang="en">temporal interval (BFO)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000203 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000008"/>
        <rdfs:label xml:lang="en">temporal instant (BFO)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2006/time#Instant -->

    <owl:Class rdf:about="http://www.w3.org/2006/time#Instant">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000203"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:label xml:lang="en">instant (OWL-Time)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2006/time#Interval -->

    <owl:Class rdf:about="http://www.w3.org/2006/time#Interval">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:label xml:lang="en">interval (OWL-Time)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2006/time#ProperInterval -->

    <owl:Class rdf:about="http://www.w3.org/2006/time#ProperInterval">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000202"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#Interval"/>
        <rdfs:label xml:lang="en">proper interval (OWL-Time)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2006/time#TemporalEntity -->

    <owl:Class rdf:about="http://www.w3.org/2006/time#TemporalEntity">
        <rdfs:label xml:lang="en">temporal entity (OWL-Time)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Agent -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Agent">
        <rdfs:label xml:lang="en">agent (PROV-O)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Entity -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Entity">
        <rdfs:label xml:lang="en">entity (PROV-O)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/shacl#NodeShape -->

    <owl:Class rdf:about="http://www.w3.org/ns/shacl#NodeShape"/>
    


    <!-- http://www.w3.org/ns/shacl#SPARQLConstraint -->

    <owl:Class rdf:about="http://www.w3.org/ns/shacl#SPARQLConstraint"/>
    


    <!-- https://w3id.org/asof-kg/ontology#AuthorizationStatement -->

    <owl:Class rdf:about="https://w3id.org/asof-kg/ontology#AuthorizationStatement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/asof-kg/ontology#TemporalStatement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/asof-kg/ontology#inRegion"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/asof-kg/ontology#Region"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">authorization statement</rdfs:label>
        <skos:definition xml:lang="en">A statement that a regulator permits use of a product for an indication in a region during the valid-time interval.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/asof-kg/ontology#ClinicalEvent -->

    <owl:Class rdf:about="https://w3id.org/asof-kg/ontology#ClinicalEvent">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/asof-kg/ontology#occursDuring"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">clinical event</rdfs:label>
        <skos:definition xml:lang="en">A process in a patient&apos;s care or disease course, such as a diagnosis, a dose or a test, placed on exactly one interval.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/asof-kg/ontology#ClosedInterval -->

    <owl:Class rdf:about="https://w3id.org/asof-kg/ontology#ClosedInterval">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2006/time#ProperInterval"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2006/time#hasEnd"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2006/time#Instant"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <owl:disjointWith rdf:resource="https://w3id.org/asof-kg/ontology#OpenInterval"/>
        <rdfs:label xml:lang="en">closed interval</rdfs:label>
        <skos:definition xml:lang="en">A proper interval that has an end instant. Defined, so the reasoner classifies intervals into it.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/asof-kg/ontology#CurrentStatement -->

    <owl:Class rdf:about="https://w3id.org/asof-kg/ontology#CurrentStatement">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/asof-kg/ontology#TemporalStatement"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/asof-kg/ontology#hasRecordTime"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/asof-kg/ontology#OpenInterval"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <owl:disjointWith rdf:resource="https://w3id.org/asof-kg/ontology#NoLongerCurrentStatement"/>
        <rdfs:label xml:lang="en">current statement</rdfs:label>
        <skos:definition xml:lang="en">A statement that has not been withdrawn or superseded as of the latest record time in the graph: its record-time interval is open. Inferred by the reasoner.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/asof-kg/ontology#EpistemicStatus -->

    <owl:Class rdf:about="https://w3id.org/asof-kg/ontology#EpistemicStatus">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/asof-kg/ontology#Asserted"/>
                    <rdf:Description rdf:about="https://w3id.org/asof-kg/ontology#Contested"/>
                    <rdf:Description rdf:about="https://w3id.org/asof-kg/ontology#Refuted"/>
                    <rdf:Description rdf:about="https://w3id.org/asof-kg/ontology#Retracted"/>
                    <rdf:Description rdf:about="https://w3id.org/asof-kg/ontology#Superseded"/>
                    <rdf:Description rdf:about="https://w3id.org/asof-kg/ontology#Supported"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">epistemic status</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/asof-kg/ontology#ExpectedActivityRevoked -->

    <owl:Class rdf:about="https://w3id.org/asof-kg/ontology#ExpectedActivityRevoked">
        <rdfs:subClassOf rdf:resource="https://w3id.org/asof-kg/ontology#AuthorizationStatement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/asof-kg/ontology#conditionalOnLineage"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/asof-kg/ontology#Lineage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">authorization lapsed for loss of activity</rdfs:label>
        <skos:definition xml:lang="en">An authorization whose validity ended because a circulating lineage was not expected to respond to the product.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/asof-kg/ontology#IndeterminateInstant -->

    <owl:Class rdf:about="https://w3id.org/asof-kg/ontology#IndeterminateInstant">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/asof-kg/ontology#earliest"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/asof-kg/ontology#latest"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">indeterminate instant</rdfs:label>
        <skos:definition xml:lang="en">An instant known only to fall between an earliest and a latest bound, such as an onset reported to the month.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/asof-kg/ontology#InstantInBebtelovimabWindow -->

    <owl:Class rdf:about="https://w3id.org/asof-kg/ontology#InstantInBebtelovimabWindow">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2006/time#Instant"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2006/time#inXSDDateTimeStamp"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2022-02-11T00:00:00-05:00</xsd:minInclusive>
                                    </rdf:Description>
                                    <rdf:Description>
                                        <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2022-11-30T00:00:00-05:00</xsd:maxExclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">instant inside the bebtelovimab U.S. authorization window</rdfs:label>
        <skos:definition xml:lang="en">Classifies any decision instant inside the valid time of ex:stmt-bebtelovimab-eua. AsOf-KG generates one such class from the valid time of each authorization statement.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/asof-kg/ontology#Lineage -->

    <owl:Class rdf:about="https://w3id.org/asof-kg/ontology#Lineage">
        <rdfs:label xml:lang="en">pathogen lineage</rdfs:label>
        <skos:definition xml:lang="en">A named pathogen lineage, such as a Pango lineage of SARS-CoV-2.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/asof-kg/ontology#NoLongerCurrentStatement -->

    <owl:Class rdf:about="https://w3id.org/asof-kg/ontology#NoLongerCurrentStatement">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/asof-kg/ontology#TemporalStatement"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/asof-kg/ontology#hasRecordTime"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/asof-kg/ontology#ClosedInterval"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">no-longer-current statement</rdfs:label>
        <skos:definition xml:lang="en">A statement that left the record (withdrawn or superseded): its record-time interval has ended. Inferred by the reasoner; the statement stays in the graph for as-of queries.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/asof-kg/ontology#OpenInterval -->

    <owl:Class rdf:about="https://w3id.org/asof-kg/ontology#OpenInterval">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2006/time#hasEnd"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">open-ended interval</rdfs:label>
        <skos:definition xml:lang="en">An interval whose end has not occurred as of the latest record time. Asserting an end for it is a logical contradiction.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/asof-kg/ontology#Prediction -->

    <owl:Class rdf:about="https://w3id.org/asof-kg/ontology#Prediction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/asof-kg/ontology#TemporalStatement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/biolink/vocab/knowledge_level"/>
                <owl:hasValue rdf:resource="https://w3id.org/biolink/vocab/prediction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/asof-kg/ontology#hasCutoff"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">prediction statement</rdfs:label>
        <skos:definition xml:lang="en">A statement produced by a model, including a temporal embedding model. It records the cutoff
time of the snapshot it was computed from. Every input it used must have entered the record before that cutoff.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/asof-kg/ontology#RecordTimeInterval -->

    <owl:Class rdf:about="https://w3id.org/asof-kg/ontology#RecordTimeInterval">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
        <owl:disjointWith rdf:resource="https://w3id.org/asof-kg/ontology#ValidTimeInterval"/>
        <rdfs:label xml:lang="en">record-time interval</rdfs:label>
        <skos:definition xml:lang="en">The interval during which a statement was available to a reader of the graph: it begins
when the source first published the statement and ends when the statement was withdrawn or superseded.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/asof-kg/ontology#Region -->

    <owl:Class rdf:about="https://w3id.org/asof-kg/ontology#Region">
        <rdfs:label xml:lang="en">geographic region</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/GAZ_00000448"/>
        <skos:definition xml:lang="en">A geographic or jurisdictional area to which a statement applies, such as a country or a public-health region.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/asof-kg/ontology#SourceRecord -->

    <owl:Class rdf:about="https://w3id.org/asof-kg/ontology#SourceRecord">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#generatedAtTime"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">source record</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
        <skos:definition xml:lang="en">A dated, citable publication of information, such as a regulatory letter, guideline version, surveillance release or article.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/asof-kg/ontology#StatusAssignment -->

    <owl:Class rdf:about="https://w3id.org/asof-kg/ontology#StatusAssignment">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/asof-kg/ontology#assignsStatus"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/asof-kg/ontology#EpistemicStatus"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/asof-kg/ontology#hasRecordTime"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/asof-kg/ontology#RecordTimeInterval"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/asof-kg/ontology#statusOf"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/asof-kg/ontology#TemporalStatement"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">status assignment</rdfs:label>
        <skos:definition xml:lang="en">The status of one statement during one record-time interval. A statement&apos;s status history is the set of its assignments.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/asof-kg/ontology#TemporalStatement -->

    <owl:Class rdf:about="https://w3id.org/asof-kg/ontology#TemporalStatement">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/biolink/vocab/Association"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/asof-kg/ontology#SourceRecord"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/asof-kg/ontology#hasRecordTime"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/asof-kg/ontology#RecordTimeInterval"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/asof-kg/ontology#hasValidTime"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/asof-kg/ontology#ValidTimeInterval"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">temporal statement</rdfs:label>
        <skos:definition xml:lang="en">A Biolink association that is qualified by exactly one valid-time interval and exactly
one record-time interval and that is derived from at least one dated source record.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/asof-kg/ontology#ValidTimeInterval -->

    <owl:Class rdf:about="https://w3id.org/asof-kg/ontology#ValidTimeInterval">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
        <rdfs:label xml:lang="en">valid-time interval</rdfs:label>
        <skos:definition xml:lang="en">The interval during which a statement is asserted to hold in the world.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/biolink/vocab/Association -->

    <owl:Class rdf:about="https://w3id.org/biolink/vocab/Association">
        <rdfs:comment xml:lang="en">Biolink Model association (reified edge).</rdfs:comment>
        <rdfs:label xml:lang="en">association (Biolink)</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/biolink/vocab/ChemicalEntity -->

    <owl:Class rdf:about="https://w3id.org/biolink/vocab/ChemicalEntity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/biolink/vocab/NamedThing"/>
        <rdfs:label xml:lang="en">chemical entity (Biolink)</rdfs:label>
    </owl:Class>
    


